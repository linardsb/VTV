# Environment
.env
.env.*
!.env.example
!.env.production.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.pytest_cache/
.pytest_lock

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
*.log
backups/

# TLS certificates (keep directory, ignore contents)
nginx/certs/*
!nginx/certs/.gitkeep

# === Node.js / Frontend ===
node_modules/
.next/
out/
dist/
.turbo/
.vercel/
*.tsbuildinfo

# pnpm
.pnpm-store/

# Environment (frontend)
cms/.env
cms/.env.local
cms/.env.*.local

# Build artifacts
cms/apps/web/.next/
# SDK client is generated but must be committed for Docker builds
# cms/packages/sdk/src/client/

# ui-ux-pro-max skill (installed locally, not committed)
.claude/skills/ui-ux-pro-max/

# Playwright MCP runtime logs
.playwright-mcp/

# ML model artifacts (tracked via models/registry.json)
models/*.pkl
models/*.joblib

# KB-2: UDPipe Latvian lemmatizer model (fetched via scripts/download_udpipe_model.sh)
models/*.udpipe

# AI-7.2 eval runs (JSONL traces are per-run artifacts)
evals/traces/*.jsonl

# AI-7.3 judge verdicts (per-run artifacts; baselines stay committed)
evals/verdicts/
evals/rag/
# NOTE: evals/baselines/ is intentionally COMMITTED so CI can compare
# against the canonical numbers.
