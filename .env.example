# Application
APP_NAME=VTV
VERSION=0.1.0
# ENVIRONMENT controls seed endpoint access:
# - "development": /api/v1/auth/seed creates demo users
# - "production" or any other value: seed endpoint returns empty (no-op)
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# Database (for local development outside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vtv_db

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8123"]

# LLM Provider (google, anthropic, ollama)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=your-google-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# LLM_FALLBACK_PROVIDER=ollama
# LLM_FALLBACK_MODEL=llama3.1:70b

# Multi-tier model routing (optional - all tiers use primary model when unset)
# Fast tier: simple lookups, status checks, single-entity queries
# LLM_FAST_PROVIDER=anthropic
# LLM_FAST_MODEL=claude-haiku-4-5
# Standard tier: default for moderate queries (uses primary model when unset)
# LLM_STANDARD_PROVIDER=anthropic
# LLM_STANDARD_MODEL=claude-sonnet-4-5
# Complex tier: multi-step analysis, bulk operations, optimization
# LLM_COMPLEX_PROVIDER=anthropic
# LLM_COMPLEX_MODEL=claude-opus-4-5

# Redis (vehicle position cache)
REDIS_URL=redis://localhost:6379/0
# Redis Authentication (set in production)
# REDIS_PASSWORD=
REDIS_VEHICLE_TTL_SECONDS=120

# Multi-feed transit (JSON array of feed configs)
# feed_type: "gtfs_rt" (default), "scraper" (JSON API), "gps_text" (semicolon-delimited)
# Leave empty to use legacy single-feed settings below
# Example multi-city config (LV-2.1):
# TRANSIT_FEEDS_JSON='[
#   {"feed_id":"riga","operator_name":"Rigas Satiksme","rt_vehicle_positions_url":"https://saraksti.rigassatiksme.lv/vehicle_positions.pb","rt_trip_updates_url":"https://saraksti.rigassatiksme.lv/trip_updates.pb","static_url":"https://saraksti.rigassatiksme.lv/gtfs.zip","poll_interval_seconds":10},
#   {"feed_id":"jurmala","operator_name":"Jurmala Transit","rt_vehicle_positions_url":"https://marsruti.lv/jurmala/gtfs_realtime.pb","static_url":"https://marsruti.lv/jurmala/gtfs.zip","poll_interval_seconds":15},
#   {"feed_id":"pieriga","operator_name":"Pieriga Transit","rt_vehicle_positions_url":"https://marsruti.lv/pieriga/gtfs_realtime.pb","static_url":"https://marsruti.lv/pieriga/gtfs.zip","poll_interval_seconds":15},
#   {"feed_id":"daugavpils","operator_name":"Daugavpils Satiksme","rt_vehicle_positions_url":"https://satiksme.daugavpils.lv/transports/karte","feed_type":"scraper","poll_interval_seconds":15},
#   {"feed_id":"liepaja","operator_name":"Liepaja Transport","rt_vehicle_positions_url":"https://marsruti.lv/liepaja/gps.txt","feed_type":"gps_text","poll_interval_seconds":15}
# ]'
TRANSIT_FEEDS_JSON=[]

# Background poller (set to false for testing or when using direct fetch)
POLLER_ENABLED=true

# WebSocket live streaming (requires POLLER_ENABLED=true for data flow)
# WS_ENABLED=true
# WS_HEARTBEAT_INTERVAL_SECONDS=30
# WS_MAX_CONNECTIONS=100

# OwnTracks MQTT (LV-3.1) - enable with `docker compose --profile mqtt up`
OWNTRACKS_MQTT_ENABLED=false
OWNTRACKS_MQTT_BROKER_URL=mqtt://mosquitto:1883
OWNTRACKS_MQTT_USERNAME=vtv
OWNTRACKS_MQTT_PASSWORD=changeme
OWNTRACKS_MQTT_TOPIC_FILTER=owntracks/+/+

# Transit GTFS-RT Feeds (Rigas Satiksme public endpoints — defaults work out of the box)
# GTFS_RT_VEHICLE_POSITIONS_URL=https://saraksti.rigassatiksme.lv/vehicle_positions.pb
# GTFS_RT_TRIP_UPDATES_URL=https://saraksti.rigassatiksme.lv/trip_updates.pb
# GTFS_RT_ALERTS_URL=https://saraksti.rigassatiksme.lv/gtfs_realtime.pb
# GTFS_STATIC_URL=https://saraksti.rigassatiksme.lv/gtfs.zip
# GTFS_RT_CACHE_TTL_SECONDS=20
# GTFS_STATIC_CACHE_TTL_HOURS=24

# Rate Limiting (requests per minute per IP)
# RATE_LIMIT_CHAT=10/minute
# RATE_LIMIT_TRANSIT=30/minute
# RATE_LIMIT_HEALTH=60/minute
# RATE_LIMIT_DEFAULT=120/minute

# Agent Query Quota (daily per IP)
# AGENT_DAILY_QUOTA=50

# JWT Authentication (backend API)
# SECURITY: Generate a strong secret for production: python -c "import secrets; print(secrets.token_hex(32))"
# The default value is ONLY safe for local development - startup fails in production without override
# Minimum 32 characters required in non-development environments
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth (REQUIRED for full `docker-compose up` — generate with: openssl rand -base64 32)
# Not needed for `make db` (local dev subset) which uses a placeholder.
# AUTH_SECRET=<generate-a-real-secret>
#
# SECURITY: Demo seed password — change in production or set ENVIRONMENT=production to disable seeding
DEMO_USER_PASSWORD=admin
#
# For production deployment, see .env.production.example

# Obsidian Vault
OBSIDIAN_API_KEY=your-obsidian-api-key
OBSIDIAN_VAULT_URL=https://127.0.0.1:27124

# Error Tracking via GlitchTip (Sentry-compatible, optional — leave empty to disable)
# Get your DSN from GlitchTip → Project Settings → Client Keys
# SENTRY_DSN=https://examplePublicKey@glitchtip.example.com/1
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Embedding Provider (openai, jina, local)
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=your-jina-api-key
# EMBEDDING_BASE_URL=https://api.jina.ai/v1

# Reranker (local, none)
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=10

# Document storage
DOCUMENT_STORAGE_PATH=data/documents

# Knowledge Base
# KNOWLEDGE_CHUNK_SIZE=512
# KNOWLEDGE_CHUNK_OVERLAP=50
# KNOWLEDGE_SEARCH_LIMIT=50

# Fleet Management / Traccar GPS Gateway
TRACCAR_ENABLED=false
TRACCAR_BASE_URL=http://traccar:8082
TRACCAR_WEBHOOK_TOKEN=vtv-traccar-webhook
FLEET_TELEMETRY_SOURCE=hardware

# Self-correction loop (AI-5.1)
AGENT_SELF_CORRECTION_ENABLED=true
AGENT_MAX_CORRECTION_ROUNDS=1

# KB-4 Search feedback loop (tuned RRF weights)
KNOWLEDGE_FEEDBACK_ENABLED=false
KNOWLEDGE_RRF_RECOMPUTE_CRON_HOUR=3
KNOWLEDGE_RRF_FEEDBACK_WINDOW_DAYS=30
KNOWLEDGE_RRF_MIN_SIGNALS_PER_TYPE=20
KNOWLEDGE_RRF_BLEND_WEIGHT=0.5

# LV-3.3 OpenTripPlanner journey-planner proxy
OTP_ENABLED=false
OTP_BASE_URL=http://otp:8080
OTP_ROUTER_ID=default
OTP_TIMEOUT_SECONDS=10
OTP_CACHE_TTL_SECONDS=300
OTP_MAX_ITINERARIES=5
OTP_MAX_WALK_DISTANCE_M=2000

# LV-3.4 Trip share links (signed tokens)
# SHARE_LINK_SECRET_KEY=                       # optional, defaults to JWT_SECRET_KEY
SHARE_LINK_DEFAULT_TTL_SECONDS=3600
SHARE_LINK_MAX_TTL_SECONDS=86400
